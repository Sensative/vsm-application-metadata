{
"name":"Presence","pirReleaseQ":{
"doc":"\nHow much of the warmth an occupied room adds must disappear before the room is reported\nfree, as a percentage.\n\n","unit":"Percent","default":25,"min":1,"max":100,"size":2,"translate":1,"id":180,"type":"input","name":"pirReleaseQ"},"pirFastDetect":{
"doc":"\n1 reports the room occupied as soon as somebody is detected. 0 waits three minutes.\n\n","unit":"Boolean","default":1,"min":0,"max":1,"size":1,"translate":1,"id":163,"type":"input","name":"pirFastDetect"},"pirPromoteDelta":{
"doc":"\nHow sharply the infrared reading must jump between two measurements for the sensor to detect\nsomebody entering.\n\n","unit":"Value","default":200,"min":1,"max":32767,"size":2,"translate":1,"id":181,"type":"input","name":"pirPromoteDelta"},"pirLevelMin":{
"doc":"\nHow much warmer than the empty room it must be for the room to count as occupied.\n\n","unit":"Value","default":150,"min":1,"max":32767,"size":2,"translate":1,"id":182,"type":"input","name":"pirLevelMin"},"pirQuietRelease":{
"doc":"\nHow long the room stays occupied with no movement detected before it is reported free.\n0 switches this off.\n\n","unit":"Seconds","default":3600,"min":0,"max":65535,"size":4,"translate":1,"id":190,"type":"input","name":"pirQuietRelease"},"pirDecisionInfo":{
"doc":"\n1 also sends the state and the six readings behind it on every state change, including the\nones that do not change presence. 0 sends only the change of presence.\n\n","unit":"Boolean","default":0,"min":0,"max":1,"size":1,"translate":1,"id":164,"type":"input","name":"pirDecisionInfo"},"GPS_TIME_MAX_AGE":{
"doc":"Once this maximum age has passed the device will no longer trust its GPS_TIME and GNSS scans become autonomous.\nAlso, it will start emitting DEVICE_TIME requests on the LoRaWan network once 80% of this time has passed.\nTypically the clock drift is a few seconds per 24 hrs. Gps time should be correct within 30s for good assisted scans.\nOutdoor use tends to increase clock drift.\n\n","uiName":"Device Time Max Age","readOnly":false,"unit":"Seconds","default":0,"min":0,"max":4294967295,"translate":1,"id":205,"type":"register","name":"GPS_TIME_MAX_AGE"},"SATELLITE_COUNT":{
"doc":"\nReads as the number of satellites seen in the last GNSS scan.\n\n","readOnly":true,"unit":"integer","translate":1,"id":206,"type":"register","name":"SATELLITE_COUNT"},"LINKCHECK_TIME":{
"doc":"How long the device goes without hearing anything from the network before it gives the network up and\ngoes to unjoined. Any downlink starts the time again, an acknowledgement as much as a message.\n\nIt asks for an answer well before then. From half of this time on, every uplink it sends is confirmed.\nFrom 80% on it also sends a confirmed link check of its own, even with nothing else to send, and\nrepeats it until something comes back. Those uplinks count towards LORA_RESEND_COUNT as well, so when\nthe network has really gone away the device usually unjoins through that count before this time is up.\n\n0 turns the check off, and then reads back as 0xFFFFFFFF. Any other value outside 300-2592000 is ignored\nand the previous one kept. The firmware sets it back to 86400 on every boot, so an application that\nwants another value writes it in a once rule.\n\nIn the unjoined state the application's own rejoin method is used; the firmware does not rejoin by itself.\n\n","uiName":"Downlink Timeout","readOnly":false,"unit":"Seconds","min":300,"max":2592000,"default":86400,"translate":1,"id":208,"type":"register","name":"LINKCHECK_TIME","used":true},"TX_POWER_RANGE":{
"doc":"Set the power index range for fast ADR, LSB = lowest, MSB = highest\nRange for each is 16 (DR0/Max power) - 0 (regions best), mixing up\nhighest and lowest does not matter (firmware always use the highest of the two as the max).\nThere is a high impact on power consumption to turn this up (lower battery time).\n\n\n","uiName":"TX Power Range","readOnly":false,"min":0,"max":65535,"unit":"2 bytes","translate":1,"id":216,"type":"register","name":"TX_POWER_RANGE"}}