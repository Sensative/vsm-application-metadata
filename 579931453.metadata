{
"name":"Pir-Motion","PirSamplingRate":{
"doc":"\nSampling rate\n1 => 0.25Hz\n2 => 0.5Hz\n3 => 1Hz\n4 => 2Hz\n5 => 4Hz\n6 => 8Hz\n7 => 15Hz\n8 => 30Hz\n\n","unit":"Index in list","default":3,"min":0,"max":16,"size":1,"translate":1,"id":160,"type":"input","name":"PirSamplingRate"},"PirLpf1":{
"doc":"\nLPF_M\n0b00xxx000 => ODR/9\n0b00xxx001 => ODR/20\n0b00xxx010 => ODR/50\n0b00xxx011 => ODR/100\n0b00xxx100 => ODR/200\n0b00xxx101 => ODR/400\n0b00xxx110 => ODR/800\n\nLPF_P_M\n0b00000xxx => ODR/9\n0b00001xxx => ODR/20\n0b00010xxx => ODR/50\n0b00011xxx => ODR/100\n0b00100xxx => ODR/200\n0b00101xxx => ODR/400\n0b00110xxx => ODR/800\n\n","unit":"Value","default":4,"skipDefaultCheck":true,"min":0,"max":63,"size":1,"translate":1,"id":161,"type":"input","name":"PirLpf1"},"PirLpf2":{
"doc":"\nLPF_A_T\n0b00xxx000 => ODR/9\n0b00xxx001 => ODR/20\n0b00xxx010 => ODR/50\n0b00xxx011 => ODR/100\n0b00xxx100 => ODR/200\n0b00xxx101 => ODR/400\n0b00xxx110 => ODR/800\n\nLPF_P\n0b00000xxx => ODR/9\n0b00001xxx => ODR/20\n0b00010xxx => ODR/50\n0b00011xxx => ODR/100\n0b00100xxx => ODR/200\n0b00101xxx => ODR/400\n0b00110xxx => ODR/800\n\n","unit":"Value","default":34,"skipDefaultCheck":true,"min":0,"max":63,"size":1,"translate":1,"id":162,"type":"input","name":"PirLpf2"},"PirAvgTrim":{
"doc":"\nAVG_TMOS\n0xX0 => 8\n0xX1 => 4\n0xX2 => 2\n0xX3 => 1\n\nAVG_T\n0x0X => 2\n0x1X => 8\n0x2X => 32\n0x3X => 128\n0x4X => 256\n0x5X => 512\n0x6X => 1024\n0x7X => 2048\n\n","unit":"Value","default":3,"skipDefaultCheck":true,"min":0,"max":63,"size":1,"translate":1,"id":163,"type":"input","name":"PirAvgTrim"},"PirCmd":{
"doc":"\n","unit":"Value","default":0,"min":0,"max":4294967295,"size":4,"translate":1,"id":184,"type":"input","name":"PirCmd"},"PirResetAlgo":{
"doc":"\nReset algo trigger\n\n","unit":"Value","default":0,"min":0,"max":1,"size":1,"translate":1,"id":164,"type":"input","name":"PirResetAlgo"},"PirMotionTheshold":{
"doc":"\nMotion threshold for motion detection algorithm\n\n","unit":"Value","default":200,"skipDefaultCheck":true,"min":0,"max":32767,"size":4,"translate":1,"id":185,"type":"input","name":"PirMotionTheshold"},"PirHystMotion":{
"doc":"\nHysteresis configuration value for motion detection algorithm\n\n","unit":"Value","default":50,"skipDefaultCheck":true,"min":0,"max":127,"size":1,"translate":1,"id":166,"type":"input","name":"PirHystMotion"},"GPS_TIME_MAX_AGE":{
"doc":"Once this maximum age has passed the device will no longer trust its GPS_TIME and GNSS scans become autonomous.\nAlso, it will start emitting DEVICE_TIME requests on the LoRaWan network once 80% of this time has passed.\nTypically the clock drift is a few seconds per 24 hrs. Gps time should be correct within 30s for good assisted scans.\nOutdoor use tends to increase clock drift.\n\n","uiName":"Device Time Max Age","readOnly":false,"unit":"Seconds","default":0,"min":0,"max":4294967295,"translate":1,"id":205,"type":"register","name":"GPS_TIME_MAX_AGE"},"SATELLITE_COUNT":{
"doc":"\nReads as the number of satellites seen in the last GNSS scan.\n\n","readOnly":true,"unit":"integer","translate":1,"id":206,"type":"register","name":"SATELLITE_COUNT"},"LINKCHECK_TIME":{
"doc":"Once 80% of this time has passed, the device will make all messages confirmed until it gets a downlink.\nShould this time pass without the device hearing a confirmed response, it will go to unjoined state.\nIn the unjoined state the applications specified rejoin method will be used.\n\n","uiName":"Downlink Timeout","readOnly":false,"unit":"Seconds","min":300,"max":2592000,"default":86400,"translate":1,"id":208,"type":"register","name":"LINKCHECK_TIME"},"TX_POWER_RANGE":{
"doc":"Set the power index range for fast ADR, LSB = lowest, MSB = highest\nRange for each is 16 (DR0/Max power) - 0 (regions best), mixing up\nhighest and lowest does not matter (firmware always use the highest of the two as the max).\nThere is a high impact on power consumption to turn this up (lower battery time).\n\n\n","uiName":"TX Power Range","readOnly":false,"min":0,"max":65535,"unit":"2 bytes","translate":1,"id":216,"type":"register","name":"TX_POWER_RANGE"}}