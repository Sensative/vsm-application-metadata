{
"name":"Presence-v24","debugMinutes":{
"doc":"\nMinutes for which the presence algorithm's internals are sent once a minute.\n\n","unit":"Minutes","default":0,"min":0,"max":65535,"size":4,"translate":1,"id":184,"type":"input","name":"debugMinutes"},"pirCommand":{
"doc":"\nA command word passed straight through to the chip, for reaching it over the air without\na new build. Same encoding as the constants above: command in byte 3, register in byte 2,\npayload in the low half. Cleared once sent, so the same command can be repeated.\n\nOnly acted on while debugMinutes is running. The command channel can stop the sensor or\nredirect a reading into the state machine's own variables, and neither is undone before\nthe next join.\n\n","unit":"Value","default":0,"min":0,"max":4294967295,"hidden":true,"size":4,"translate":1,"id":189,"type":"input","name":"pirCommand"},"pirBusyPresHold":{
"doc":"\nTPresence above this holds the room occupied regardless of motion.\n\n","unit":"Value","default":500,"min":0,"max":32767,"size":2,"translate":1,"id":179,"type":"input","name":"pirBusyPresHold"},"pirQuietDev":{
"doc":"\nMean absolute change in TObject below which the signal counts as quiet.\n\n","unit":"Value","default":40,"min":0,"max":32767,"size":2,"translate":1,"id":180,"type":"input","name":"pirQuietDev"},"GPS_TIME_MAX_AGE":{
"doc":"Once this maximum age has passed the device will no longer trust its GPS_TIME and GNSS scans become autonomous.\nAlso, it will start emitting DEVICE_TIME requests on the LoRaWan network once 80% of this time has passed.\nTypically the clock drift is a few seconds per 24 hrs. Gps time should be correct within 30s for good assisted scans.\nOutdoor use tends to increase clock drift.\n\n","uiName":"Device Time Max Age","readOnly":false,"unit":"Seconds","default":0,"min":0,"max":4294967295,"translate":1,"id":205,"type":"register","name":"GPS_TIME_MAX_AGE"},"SATELLITE_COUNT":{
"doc":"\nReads as the number of satellites seen in the last GNSS scan.\n\n","readOnly":true,"unit":"integer","translate":1,"id":206,"type":"register","name":"SATELLITE_COUNT"},"LINKCHECK_TIME":{
"doc":"Once 80% of this time has passed, the device will make all messages confirmed until it gets a downlink.\nShould this time pass without the device hearing a confirmed response, it will go to unjoined state.\nIn the unjoined state the applications specified rejoin method will be used.\n\n","uiName":"Downlink Timeout","readOnly":false,"unit":"Seconds","min":300,"max":2592000,"default":86400,"translate":1,"id":208,"type":"register","name":"LINKCHECK_TIME"},"TX_POWER_RANGE":{
"doc":"Set the power index range for fast ADR, LSB = lowest, MSB = highest\nRange for each is 16 (DR0/Max power) - 0 (regions best), mixing up\nhighest and lowest does not matter (firmware always use the highest of the two as the max).\nThere is a high impact on power consumption to turn this up (lower battery time).\n\n\n","uiName":"TX Power Range","readOnly":false,"min":0,"max":65535,"unit":"2 bytes","translate":1,"id":216,"type":"register","name":"TX_POWER_RANGE"}}